{
    "default": {
        "paths": [
            "features"
        ],
        "require": [
            "src/steps/*.ts"
        ],
        "formatOptions": {
            "snippetInterface":"async-await"
        },
        "format": [
            "json:reports/cucumber.json",
            "html:reports/cucumber.html",
            "progress"
        ],
        "dryrun": true,
        "headless": false
    }
}