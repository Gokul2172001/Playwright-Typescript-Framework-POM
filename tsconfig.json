{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
	"types": [
  	"node"
	],
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
	"src/**/*.ts",
    "src/**/**/*.ts",
    "src/page/**/*.ts"
  ],
  "exclude": [
    "node_modules",
	"dist",
    "reports",
    "playwright-report",
    "allure-report"
  ]
}
 
